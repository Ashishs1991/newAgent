# Required
OPENAI_API_KEY=
TAVILY_API_KEY=

# Model and run limits (application-enforced)
OPENAI_MODEL=gpt-5-mini
MAX_OUTPUT_TOKENS=1200
MAX_MODEL_CALLS=4
MAX_TOOL_CALLS=3
TAVILY_MAX_RESULTS=5

# LangSmith tracing (optional; see README)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=job-research-agent
