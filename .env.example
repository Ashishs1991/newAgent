# Required
OPENAI_API_KEY=
TAVILY_API_KEY=

# Model and run limits (application-enforced)
OPENAI_MODEL=gpt-5-mini
# gpt-5-* models bill reasoning_tokens inside this cap; use 4096+ not 500–1000
MAX_OUTPUT_TOKENS=4096
OPENAI_REASONING_EFFORT=low
# Search + structured final output often needs 4–5 model turns
MAX_MODEL_CALLS=5
MAX_TOOL_CALLS=2
TAVILY_MAX_RESULTS=3

# Optional — approximate OpenAI USD for baseline cost estimates (agent loop tokens only)
# OPENAI_INPUT_USD_PER_1M=
# OPENAI_OUTPUT_USD_PER_1M=

# LangSmith tracing (optional; see README)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=job-research-agent
